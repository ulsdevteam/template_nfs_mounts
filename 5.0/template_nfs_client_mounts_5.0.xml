<?xml version='1.0' encoding='UTF-8'?>
<zabbix_export>
    <version>5.0</version>
    <date>2026-10-26T20:00:00Z</date>
    <groups>
        <group>
            <name>Templates/Operating systems</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template NFS Client Mounts</template>
            <name>Template NFS Client Mounts</name>
            <description>NFS client monitoring: per-mount accessibility (stat), server reachability, space usage and statistics from /proc/self/mountstats. Needs userparameter_nfs.conf, nfs_discovery.sh and nfs_mount_stat.sh on the host.</description>
            <groups>
                <group>
                    <name>Templates/Operating systems</name>
                </group>
            </groups>
            <macros>
                <macro>
                    <macro>{$NFS.PFREE.HIGH}</macro>
                    <value>5</value>
                    <description>Free space % below which HIGH fires</description>
                </macro>
                <macro>
                    <macro>{$NFS.PFREE.AVG}</macro>
                    <value>10</value>
                    <description>Free space % below which AVERAGE fires</description>
                </macro>
                <macro>
                    <macro>{$NFS.PFREE.WARN}</macro>
                    <value>20</value>
                    <description>Free space % below which WARNING fires</description>
                </macro>
                <macro>
                    <macro>{$NFS.AGE.MIN}</macro>
                    <value>300</value>
                    <description>Mount age (s) under which a remount is reported</description>
                </macro>
                <macro>
                    <macro>{$NFS.RETRANS.RATE}</macro>
                    <value>0</value>
                    <description>RPC retransmissions/s that must be exceeded for 10m to alert</description>
                </macro>
            </macros>
            <discovery_rules>
                <discovery_rule>
                    <name>NFS mounts discovery</name>
                    <key>nfs.discovery</key>
                    <delay>15m</delay>
                    <lifetime>7d</lifetime>
                    <description>Returns {#MOUNTPOINT} and {#SERVER} (bare host name or IP) for each NFS mount.</description>
                    <item_prototypes>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] accessibility (stat exit code)</name>
                            <key>nfs.mount.check[{#MOUNTPOINT}]</key>
                            <delay>1m</delay>
                            <description>Exit code of a timed stat on the mount point. 0 = OK, 124/137 = hung (timeout fired), 1/2 = missing or stale handle.</description>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS server [{#SERVER}] reachable via rpcinfo (mount {#MOUNTPOINT})</name>
                            <key>nfs.server.check[{#SERVER},{#MOUNTPOINT}]</key>
                            <delay>1m</delay>
                            <description>1 if the server answers for the NFS program (100003), 0 otherwise.</description>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] age</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},age]</key>
                            <delay>1m</delay>
                            <units>s</units>
                            <description>Seconds since the mount was established.</description>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] bytes read (application level)</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},bytes_read]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>Bps</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] bytes written (application level)</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},bytes_written]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>Bps</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] READ operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},read]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] WRITE operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},write]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] GETATTR operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},getattr]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] SETATTR operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},setattr]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] CREATE operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},create]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] REMOVE operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},remove]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] RENAME operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},rename]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] READDIR operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},readdir]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] COMMIT operations/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},commit]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>ops/s</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] RPC retransmissions/s</name>
                            <key>nfs.mount.stat[{#MOUNTPOINT},retrans_total]</key>
                            <delay>1m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>retrans/s</units>
                            <description>Sum over all ops of (transmissions - ops).</description>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                            <preprocessing>
                                <step>
                                    <type>CHANGE_PER_SECOND</type>
                                    <params />
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] free space</name>
                            <key>vfs.fs.size[{#MOUNTPOINT},free]</key>
                            <delay>5m</delay>
                            <units>B</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] free space (%)</name>
                            <key>vfs.fs.size[{#MOUNTPOINT},pfree]</key>
                            <delay>5m</delay>
                            <value_type>FLOAT</value_type>
                            <units>%</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] total space</name>
                            <key>vfs.fs.size[{#MOUNTPOINT},total]</key>
                            <delay>5m</delay>
                            <units>B</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <name>NFS mount [{#MOUNTPOINT}] used space</name>
                            <key>vfs.fs.size[{#MOUNTPOINT},used]</key>
                            <delay>5m</delay>
                            <units>B</units>
                            <application_prototypes>
                                <application_prototype>
                                    <name>NFS {#MOUNTPOINT}</name>
                                </application_prototype>
                            </application_prototypes>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:nfs.server.check[{#SERVER},{#MOUNTPOINT}].max(#2)}=0</expression>
                            <name>NFS server {#SERVER} is not responding (checked for {#MOUNTPOINT})</name>
                            <priority>HIGH</priority>
                            <description>The server check failed twice in a row.</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:nfs.mount.check[{#MOUNTPOINT}].min(#2)}&gt;0</expression>
                            <name>NFS mount {#MOUNTPOINT} is not accessible</name>
                            <priority>HIGH</priority>
                            <description>stat on the mount point failed or timed out twice in a row (hung or stale mount).</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:vfs.fs.size[{#MOUNTPOINT},pfree].last()}&lt;{$NFS.PFREE.HIGH}</expression>
                            <name>NFS mount {#MOUNTPOINT}: free space below {$NFS.PFREE.HIGH}%</name>
                            <priority>HIGH</priority>
                            <dependencies>
                                <dependency>
                                    <name>NFS mount {#MOUNTPOINT} is not accessible</name>
                                    <expression>{Template NFS Client Mounts:nfs.mount.check[{#MOUNTPOINT}].min(#2)}&gt;0</expression>
                                </dependency>
                            </dependencies>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:vfs.fs.size[{#MOUNTPOINT},pfree].last()}&lt;{$NFS.PFREE.AVG}</expression>
                            <name>NFS mount {#MOUNTPOINT}: free space below {$NFS.PFREE.AVG}%</name>
                            <priority>AVERAGE</priority>
                            <dependencies>
                                <dependency>
                                    <name>NFS mount {#MOUNTPOINT}: free space below {$NFS.PFREE.HIGH}%</name>
                                    <expression>{Template NFS Client Mounts:vfs.fs.size[{#MOUNTPOINT},pfree].last()}&lt;{$NFS.PFREE.HIGH}</expression>
                                </dependency>
                            </dependencies>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:vfs.fs.size[{#MOUNTPOINT},pfree].last()}&lt;{$NFS.PFREE.WARN}</expression>
                            <name>NFS mount {#MOUNTPOINT}: free space below {$NFS.PFREE.WARN}%</name>
                            <priority>WARNING</priority>
                            <dependencies>
                                <dependency>
                                    <name>NFS mount {#MOUNTPOINT}: free space below {$NFS.PFREE.AVG}%</name>
                                    <expression>{Template NFS Client Mounts:vfs.fs.size[{#MOUNTPOINT},pfree].last()}&lt;{$NFS.PFREE.AVG}</expression>
                                </dependency>
                            </dependencies>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:nfs.mount.stat[{#MOUNTPOINT},age].last()}&lt;{$NFS.AGE.MIN}</expression>
                            <name>NFS mount {#MOUNTPOINT} was (re)mounted less than {$NFS.AGE.MIN}s ago</name>
                            <priority>INFO</priority>
                            <description>Mount age is below the threshold; the filesystem was recently mounted or remounted.</description>
                            <dependencies>
                                <dependency>
                                    <name>NFS mount {#MOUNTPOINT} is not accessible</name>
                                    <expression>{Template NFS Client Mounts:nfs.mount.check[{#MOUNTPOINT}].min(#2)}&gt;0</expression>
                                </dependency>
                            </dependencies>
                        </trigger_prototype>
                        <trigger_prototype>
                            <expression>{Template NFS Client Mounts:nfs.mount.stat[{#MOUNTPOINT},retrans_total].min(10m)}&gt;{$NFS.RETRANS.RATE}</expression>
                            <name>NFS mount {#MOUNTPOINT}: sustained RPC retransmissions</name>
                            <priority>WARNING</priority>
                            <description>Retransmissions occurred in every sample for 10 minutes; check the network path and server load.</description>
                            <dependencies>
                                <dependency>
                                    <name>NFS mount {#MOUNTPOINT} is not accessible</name>
                                    <expression>{Template NFS Client Mounts:nfs.mount.check[{#MOUNTPOINT}].min(#2)}&gt;0</expression>
                                </dependency>
                            </dependencies>
                        </trigger_prototype>
                    </trigger_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <name>NFS throughput on {#MOUNTPOINT}</name>
                            <graph_items>
